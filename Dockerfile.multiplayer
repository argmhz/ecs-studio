FROM node:22-bookworm-slim

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=8080 \
    TICK_RATE=60 \
    MAX_PLAYERS=8 \
    MAX_ROOMS=500

WORKDIR /app
COPY . .
RUN npm ci --omit=dev --workspace @ecs/multiplayer-host --include-workspace-root=false

USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 CMD node -e "fetch('http://127.0.0.1:' + (process.env.PORT || 8080) + '/healthz').then(response => { if (!response.ok) process.exit(1); }).catch(() => process.exit(1))"
CMD ["node", "--experimental-strip-types", "examples/multiplayer-host/src/main.ts"]
